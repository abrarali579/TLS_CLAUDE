# Claude Code local settings
.claude/

# Graphify generated output — keep only the report and graph data
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json

# Dependencies
node_modules/

# Build output — regenerate with `npm run build`, never edit by hand
dist/

# Real data exports — plain-text copies of your books. Never commit these.
import/*.csv
import/*.json
import/report.md

# The server's database — your actual books. NEVER commit this.
data/
*.db
*.db-wal
*.db-shm

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Environment / secrets
.env
.env.*
*.pem
*.key

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
